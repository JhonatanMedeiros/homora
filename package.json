{
  "name": "homora",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "type-check": "node scripts/ci/typecheck.mjs",
    "test": "vitest run && node --test scripts/test/*.test.mjs",
    "db:generate": "pnpm --filter @homora/db db:generate",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --quiet --report-unused-disable-directives-severity error .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "node scripts/check.mjs",
    "prepare": "husky",
    "backup": "node scripts/backup.mjs",
    "auth:reset": "node scripts/auth-reset.mjs",
    "css:reset": "node scripts/css-reset.mjs",
    "integration:create": "node scripts/create-integration.mjs",
    "integration:catalog": "node packages/integrations/scripts/integration-catalog.mjs --write",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "widget:create": "node scripts/create-widget.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "2.11.12",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "vitepress": "1.6.4",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,html,css,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "type": "module"
}
