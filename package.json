{
  "name": "homora",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5 <2"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "type-check": "bun scripts/ci/typecheck.mjs",
    "test": "bun --bun vitest run && bun test scripts/test",
    "db:generate": "bun run --filter @homora/db db:generate",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --quiet --report-unused-disable-directives-severity error .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun scripts/check.mjs",
    "prepare": "husky",
    "backup": "bun scripts/backup.mjs",
    "auth:reset": "bun scripts/auth-reset.mjs",
    "css:reset": "bun scripts/css-reset.mjs",
    "integration:create": "bun scripts/create-integration.mjs",
    "integration:catalog": "bun packages/integrations/scripts/integration-catalog.mjs --write",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "widget:create": "bun scripts/create-widget.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "2.11.12",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "vitepress": "1.6.4",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,html,css,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "vitepress": {
      "vite": "6.4.6"
    }
  }
}
