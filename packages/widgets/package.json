{
  "name": "@homora/widgets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./clock": {
      "types": "./dist/clock.d.ts",
      "default": "./dist/clock.js"
    },
    "./note": {
      "types": "./dist/note.d.ts",
      "default": "./dist/note.js"
    },
    "./system-telemetry": {
      "types": "./dist/system-telemetry.d.ts",
      "default": "./dist/system-telemetry.js"
    },
    "./countdown": {
      "types": "./dist/countdown.d.ts",
      "default": "./dist/countdown.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./clock/ui": "./src/widgets/clock/ui/index.tsx",
    "./countdown/ui": "./src/widgets/countdown/ui/index.tsx",
    "./note/ui": "./src/widgets/note/ui/index.tsx",
    "./ui": "./src/ui/host.tsx",
    "./translations": {
      "types": "./dist/translations.d.ts",
      "default": "./dist/translations.js"
    },
    "./note/ui/view": "./src/widgets/note/ui/view.tsx",
    "./calendar/ui": "./src/widgets/calendar/ui/index.tsx",
    "./homelab-summary/ui": "./src/widgets/homelab-summary/ui/index.tsx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@homora/ui": "workspace:*",
    "date-fns": "^4.4.0",
    "lucide-react": "1.72.0",
    "react-markdown": "^10.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
