# Local development ports
HOMORA_API_PORT=3000
HOMORA_WEB_PORT=5173
# Additional HTTPS origins for use behind reverse proxy (comma-separated).
# Configure the proxy with HTTPS and Host and X-Forwarded-For forwarding, without exposing the API.
# In Compose, also set HOMORA_TRUSTED_PROXY to the proxy address or network (see README).
# HOMORA_ALLOWED_ORIGINS=https://homora.example.home
# Domain that passkeys are bound to (default: localhost). Needs an HTTPS origin under it in
# HOMORA_ALLOWED_ORIGINS. Changing it later makes existing passkeys unusable (see ADR 0017).
# HOMORA_PASSKEY_RP_ID=example.home
# Path relative to project root or absolute
HOMORA_DATABASE_PATH=data/homora.sqlite
# 32-byte secret key in hex format for token encryption (64 hexadecimal characters).
# If not provided, a key derived from the admin password will be used (dev only!).
# HOMORA_VAULT_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Secret for signing web session cookies (at least 32 characters).
# If not provided, a random one is created next to the database (<database>.session-secret).
# HOMORA_SESSION_SECRET=change-this-session-secret-min-32-chars
# Secret for signing Proxmox tickets (at least 32 characters)
# If not provided, the session secret or vault key is used
# HOMORA_PROXMOX_TICKET_SECRET=change-this-proxmox-secret-min-32-chars
