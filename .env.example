# Portas locais para desenvolvimento
HOMORA_API_PORT=3000
HOMORA_WEB_PORT=5173
# Origens HTTPS adicionais para uso atrás de proxy reverso (separadas por vírgula).
# Configure o proxy com HTTPS e encaminhamento de Host e X-Forwarded-For, sem expor a API.
# No Compose, defina também HOMORA_TRUSTED_PROXY com o endereço ou a rede do proxy (veja o README).
# HOMORA_ALLOWED_ORIGINS=https://homora.example.home
# Caminho relativo à raiz do projeto ou absoluto
HOMORA_DATABASE_PATH=data/homora.sqlite
