  "narrative": {
    "northStar": "A Cozinha da Casa",
    "overview": "Homora é o lugar da casa onde tudo fica à mão: quente, de uso diário, sem cerimônia. Neutros quentes e um único acento âmbar; plano, com bordas finas; usar vem antes de organizar.",
    "keyCharacteristics": [
      "Neutros quentes e um único acento âmbar.",
      "Estado sempre com cor, forma e texto.",
      "Bordas finas no lugar de sombras.",
      "Gestão escondida atrás de Organizar."
    ],
    "rules": [
      {
        "name": "The One Honey Rule",
        "body": "O âmbar ocupa no máximo 10% de qualquer tela.",
        "section": "colors"
      },
      {
        "name": "The Never Color Alone Rule",
        "body": "Estado nunca é só cor: forma e texto sempre juntos.",
        "section": "colors"
