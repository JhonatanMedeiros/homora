{
  "name": "@homora/backend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/dev-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/server.js",
    "bench": "bun bench/run.ts",
    "mcp": "bun dist/mcp-server.js",
    "compile": "bun build --compile --minify src/server.ts --outfile dist/homora",
    "compile:mcp": "bun build --compile --minify src/mcp-server.ts --outfile dist/homora-mcp"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.25",
    "@fastify/rate-limit": "^11.2.2",
    "@homora/db": "workspace:*",
    "@homora/i18n": "workspace:*",
    "@homora/icons": "workspace:*",
    "@homora/integrations": "workspace:*",
    "@homora/shared": "workspace:*",
    "@homora/utils": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "i18next": "^27.1.5",
    "sharp": "^0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "@homora/widgets": "workspace:*"
  },
  "devDependencies": {
    "@simplewebauthn/server": "13.3.2",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
