{
  "name": "@homora/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/dev-server.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "start": "bun dist/server.js",
    "bench": "bun bench/run.ts",
    "mcp": "bun dist/mcp-server.js",
    "compile": "bun build --compile --minify src/server.ts --outfile dist/homora",
    "compile:mcp": "bun build --compile --minify src/mcp-server.ts --outfile dist/homora-mcp"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@homora/db": "workspace:*",
    "@homora/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-auth": "1.7.21",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "sharp": "^0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
