{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "CHANGELOG.md",
    "**/dist",
    ".turbo",
    ".idea",
    ".agent",
    ".agents",
    ".claude",
    ".github/agents",
    ".github/skills",
    ".impeccable",
    "data",
    "bun.lock",
    "packages/db/migrations",
    "packages/db/src/migrations.generated.ts",
    "coverage",
    ".codex",
    ".hermes",
    "skills-lock.json"
  ]
}
